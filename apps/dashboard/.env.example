DATABASE_URL="file:../../packages/database/prisma/dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
DEEPSEEK_API_KEY=""

# Google Analytics Service Account
GA_SERVICE_ACCOUNT_EMAIL=""
GA_PRIVATE_KEY=""

# ───────── Portfolio Growth Agent ─────────
# Shared secret sent to each product's /api/portfolio/stats beacon (set the SAME
# value on every product). Generate once, e.g. `openssl rand -hex 32`.
PORTFOLIO_BEACON_SECRET=""
# Protects the daily cron route. Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
# Who the cron runs for + emails (defaults to WIDGET_OWNER_EMAIL / info@donkeyideas.com).
PORTFOLIO_OWNER_EMAIL="info@donkeyideas.com"
PORTFOLIO_EMAIL_TO="info@donkeyideas.com"
PORTFOLIO_EMAIL_FROM="info@donkeyideas.com"   # must be a SendGrid-verified sender
# SendGrid key for the briefing email (falls back to the owner's UserSettings.sendgridApiKey).
SENDGRID_API_KEY=""
# Per-product beacon base URLs (agent appends /api/portfolio/stats). Leave blank
# to score that product from dashboard data only.
BEACON_URL_ARGUFIGHT=""
BEACON_URL_OPTICRANK=""
BEACON_URL_TOPVISO=""
BEACON_URL_GOVIRAL=""
BEACON_URL_BUILDWRK=""
BEACON_URL_HAVANA=""
BEACON_URL_BASKTBALL=""
BEACON_URL_CFBSOCIAL=""
BEACON_URL_JETDALE=""
BEACON_URL_JULYU=""
BEACON_URL_KAMIOI=""
BEACON_URL_MARBLE=""
