{
  "expo": {
    "name": "Donkey Ideas",
    "slug": "donkey-ideas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "donkeyideas",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.donkeyideas.mobile",
      "navigationBarColor": "#0a0a0a",
      "navigationBarStyle": "light"
    },
    "ios": {
      "bundleIdentifier": "com.donkeyideas.mobile",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "jsEngine": "hermes",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "router": {
        "root": "./app"
      },
      "adminApiToken": "wgt_033cd90a55ad7098ac486b4c6df849a3306d3c4cb38f2e13",
      "eas": {
        "projectId": "a611558a-1ab4-45ab-8049-ce2034b1f0f0"
      }
    },
    "owner": "beltranalain"
  }
}
